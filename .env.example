# Hosted Supabase project used by Next.js in development and production.
# Copy these public values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key

# Server only: used by the restricted auth_account_exists RPC, never in the browser.
SUPABASE_SERVER_SECRET_KEY=sb_secret_replace_with_server_key

# Optional: Google OAuth credentials ONLY for the local Supabase Auth service.
# The hosted provider must be configured in Supabase Dashboard > Authentication.
# Never prefix the client secret with NEXT_PUBLIC_.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace_with_google_web_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace_with_google_web_client_secret

# Optional server-only reverse-geocoding provider. No API key required for demo.
# Moderate usage only; use a managed/private instance for larger traffic.
PHOTON_REVERSE_URL=https://photon.komoot.io/reverse
