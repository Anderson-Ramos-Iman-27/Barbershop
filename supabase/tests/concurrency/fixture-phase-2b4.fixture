-- Fixture exclusivamente local para el arnés de concurrencia 2B.4.
-- Los UUID se reservan para pruebas y el runner los elimina al reiniciar Supabase local.
insert into auth.users (id, email) values
  ('70000000-0000-0000-0000-000000000001', 'concurrency-client-a@example.test'),
  ('70000000-0000-0000-0000-000000000002', 'concurrency-client-b@example.test'),
  ('70000000-0000-0000-0000-000000000003', 'concurrency-admin@example.test')
on conflict do nothing;

update public.profiles set role = 'admin'
where id = '70000000-0000-0000-0000-000000000003';

insert into public.services (id,name,description,price_pen_centavos,duration_minutes,is_active,is_published)
values ('70000000-0000-0000-0000-000000000010','Concurrencia local','Fixture no comercial',1000,30,true,true)
on conflict do nothing;
insert into public.service_modes (service_id,mode) values ('70000000-0000-0000-0000-000000000010','local') on conflict do nothing;
insert into public.professionals (id,display_name,is_active,is_published) values
 ('70000000-0000-0000-0000-000000000020','Profesional A',true,true),
 ('70000000-0000-0000-0000-000000000021','Profesional B',true,true)
on conflict do nothing;
insert into public.professional_services (professional_id,service_id) values
 ('70000000-0000-0000-0000-000000000020','70000000-0000-0000-0000-000000000010'),
 ('70000000-0000-0000-0000-000000000021','70000000-0000-0000-0000-000000000010') on conflict do nothing;
insert into public.professional_working_hours(professional_id,weekday,starts_at,ends_at,effective_from)
select p.id,d,'00:00'::time,'23:59'::time,current_date
from (values ('70000000-0000-0000-0000-000000000020'::uuid),('70000000-0000-0000-0000-000000000021'::uuid)) p(id)
cross join generate_series(1,7) d on conflict do nothing;

select set_config('request.jwt.claim.sub','70000000-0000-0000-0000-000000000003',false);
update public.business_settings set booking_enabled=true, professional_assignment_mode='customer_choice', approval_max_pending_minutes=1440, approval_cutoff_before_start_minutes=360, cancellation_notice_minutes=720, reschedule_proposal_ttl_minutes=360 where id=1;
